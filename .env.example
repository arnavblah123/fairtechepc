# Postgres connection string from Neon (Dashboard -> Connection Details -> Pooled connection)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) URL from Neon, used only for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Long random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"
# Initial superadmin credentials used by the seed script (change the password after first login)
SEED_ADMIN_USERNAME="arnav"
SEED_ADMIN_PASSWORD="ChangeMe@123"
# Vercel Blob token (added automatically when you connect Blob storage in Vercel)
BLOB_READ_WRITE_TOKEN=""
