// Fairtech Site Manager - data model
// Every operational record carries a siteId so a second site can be added without a rewrite.
// Nothing is hard-deleted: rows carry voidedAt / voidReason or an `active` flag.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth & users
// ---------------------------------------------------------------------------

enum Role {
  SUPERADMIN
  SITE_INCHARGE
  SUPERVISOR
  PURCHASE // head-office purchase desk (Pune): places orders, not attached to a site
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  siteId       String?
  site         Site?     @relation(fields: [siteId], references: [id])
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions  Session[]
  auditLogs AuditLog[]

  createdJobs            Job[]
  stageProgressEntries   StageProgress[]           @relation("StageProgressEnteredBy")
  attendanceMarked       Attendance[]              @relation("AttendanceMarkedBy")
  advancesRequested      Advance[]                 @relation("AdvanceRequestedBy")
  advancesDecided        Advance[]                 @relation("AdvanceDecidedBy")
  wageRatesSet           WageRate[]
  wageSheetsGenerated    WageSheet[]
  pettyRequestsRaised    PettyCashRequest[]        @relation("PettyReqRequestedBy")
  pettyRequestsDecided   PettyCashRequest[]        @relation("PettyReqDecidedBy")
  pettyTxnsEntered       PettyCashTxn[]
  reconciliations        PettyCashReconciliation[]
  machineDispatchesSent  MachineDispatch[]         @relation("MachineDispatchedBy")
  machineDispatchesRecvd MachineDispatch[]         @relation("MachineReceivedBy")
  ticketsRaised          MachineTicket[]           @relation("TicketRaisedBy")
  ticketsVerified        MachineTicket[]           @relation("TicketVerifiedBy")
  consDispatchesSent     ConsumableDispatch[]      @relation("ConsDispatchedBy")
  consDispatchesRecvd    ConsumableDispatch[]      @relation("ConsReceivedBy")
  consumptionsEntered    ConsumableConsumption[]
  consRequestsRaised     ConsumableRequest[]       @relation("ConsReqRequestedBy")
  consRequestsOrdered    ConsumableRequest[]       @relation("ConsReqOrderedBy")
  jobMaterialsAdded      JobMaterial[]
  itemsProposed          ConsumableItem[]          @relation("ItemProposedBy")
  indentsRaised          MaterialIndent[]          @relation("IndentRequestedBy")
  billsSpent             Bill[]                    @relation("BillSpentBy")
  billsEntered           Bill[]                    @relation("BillEnteredBy")
  expensesSpent          Expense[]                 @relation("ExpenseSpentBy")
  expensesEntered        Expense[]                 @relation("ExpenseEnteredBy")
  expensesDecided        Expense[]                 @relation("ExpenseDecidedBy")
  cashLedger             CashLedger[]              @relation("LedgerHolder")
  cashLedgerPosted       CashLedger[]              @relation("LedgerPostedBy")
  consRequestsDecided    ConsumableRequest[]       @relation("ConsReqDecidedBy")
  issuesRaised           Issue[]                   @relation("IssueRaisedBy")
  issuesClosed           Issue[]                   @relation("IssueClosedBy")
  dailyPlansSubmitted    DailyPlan[]
  dprsSubmitted          DPR[]
  photosTaken            SitePhoto[]
  backdateUnlocks        BackdateUnlock[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Site
// ---------------------------------------------------------------------------

model Site {
  id                 String   @id @default(cuid())
  code               String   @unique // short prefix used in job numbers, e.g. "SITE" -> SITE-001
  name               String
  city               String
  address            String?
  latitude           Float?
  longitude          Float?
  pettyCashThreshold Decimal  @default(5000) @db.Decimal(12, 2)
  dprCutoffHour      Int      @default(20) // 8 PM IST
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users             User[]
  jobs              Job[]
  jobMaterials      JobMaterial[]
  expenses          Expense[]
  bills             Bill[]
  indents           MaterialIndent[]
  parties           Party[]
  cashLedger        CashLedger[]
  stages            Stage[]
  stageProgress     StageProgress[]
  workers           Worker[]
  attendance        Attendance[]
  holidays          Holiday[]
  advances          Advance[]
  wageSheets        WageSheet[]
  pettyRequests     PettyCashRequest[]
  pettyTxns         PettyCashTxn[]
  reconciliations   PettyCashReconciliation[]
  machines          Machine[]
  machineDispatches MachineDispatch[]
  machineTickets    MachineTicket[]
  consDispatches    ConsumableDispatch[]
  consStock         ConsumableStock[]
  consConsumptions  ConsumableConsumption[]
  consRequests      ConsumableRequest[]
  issues            Issue[]
  dailyPlans        DailyPlan[]
  dprs              DPR[]
  photos            SitePhoto[]
  auditLogs         AuditLog[]
  backdateUnlocks   BackdateUnlock[]
}

// ---------------------------------------------------------------------------
// Jobs & stages
// ---------------------------------------------------------------------------

enum JobStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED
}

enum QtyUnit {
  MT
  NOS
  METRE
  SQM
}

model Job {
  id                 String    @id @default(cuid())
  siteId             String
  site               Site      @relation(fields: [siteId], references: [id])
  jobNumber          String    @unique // e.g. SITE-001
  name               String
  clientName         String
  description        String?
  drawingRef         String?
  plannedTonnage     Decimal?  @db.Decimal(12, 3) // reference only, not a progress metric
  plannedStart       DateTime  @db.Date
  plannedEnd         DateTime  @db.Date
  actualStart        DateTime? @db.Date
  actualEnd          DateTime? @db.Date
  status             JobStatus @default(ACTIVE)
  weldingNormKgPerMT Decimal?  @db.Decimal(8, 3) // consumption norm; null = no check
  createdById        String
  createdBy          User      @relation(fields: [createdById], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  voidedAt           DateTime?
  voidReason         String?

  stages        Stage[]
  materials     JobMaterial[]
  stageProgress StageProgress[]
  consumptions  ConsumableConsumption[]
  issues        Issue[]
  planItems     DailyPlanItem[]
  photos        SitePhoto[]
  expenses      Expense[]
}

/// Consumables planned for a job before work starts. Requests are drawn against this.
model JobMaterial {
  id         String         @id @default(cuid())
  siteId     String
  site       Site           @relation(fields: [siteId], references: [id])
  jobId      String
  job        Job            @relation(fields: [jobId], references: [id])
  itemId     String
  item       ConsumableItem @relation(fields: [itemId], references: [id])
  plannedQty Decimal        @db.Decimal(12, 3)
  note       String?
  addedById  String
  addedBy    User           @relation(fields: [addedById], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  voidedAt   DateTime?
  voidReason String?

  @@unique([jobId, itemId])
  @@index([siteId])
}

model Stage {
  id          String    @id @default(cuid())
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id])
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id])
  sequence    Int
  name        String
  /// What will be done in this stage, in the superadmin's words. Shown to the site.
  scope       String?
  unit        QtyUnit   @default(MT) // legacy; no longer entered
  plannedQty  Decimal   @default(0) @db.Decimal(12, 3) // legacy; no longer entered
  plannedDays Int
  actualStart DateTime? @db.Date
  actualEnd   DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  voidedAt    DateTime?
  voidReason  String?

  progress     StageProgress[]
  planItems    DailyPlanItem[]
  consumptions ConsumableConsumption[]
  photos       SitePhoto[]

  @@unique([jobId, sequence])
  @@index([siteId])
}

/// One row per stage per date. Workers and hours are in StageWorkLog.
model StageProgress {
  id          String    @id @default(cuid())
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id])
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id])
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id])
  date        DateTime  @db.Date
  qtyDone     Decimal   @default(0) @db.Decimal(12, 3)
  remark      String?
  enteredById String
  enteredBy   User      @relation("StageProgressEnteredBy", fields: [enteredById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  voidedAt    DateTime?
  voidReason  String?

  workLogs StageWorkLog[]

  @@unique([stageId, date])
  @@index([siteId, date])
}

enum Shift {
  DAY
  NIGHT
}

model StageWorkLog {
  id              String        @id @default(cuid())
  stageProgressId String
  stageProgress   StageProgress @relation(fields: [stageProgressId], references: [id], onDelete: Cascade)
  workerId        String
  worker          Worker        @relation(fields: [workerId], references: [id])
  date            DateTime      @db.Date
  shift           Shift         @default(DAY)
  hours           Decimal       @default(8) @db.Decimal(4, 1)

  // A worker can only be on one stage per day per shift.
  @@unique([workerId, date, shift])
}

// ---------------------------------------------------------------------------
// Labour
// ---------------------------------------------------------------------------

enum Trade {
  FITTER
  WELDER
  GRINDER
  GAS_CUTTER
  HELPER
  RIGGER
  PAINTER
}

enum WageType {
  PER_HOUR
  PER_DAY
}

model Worker {
  id             String    @id @default(cuid())
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id])
  code           String // e.g. W-001, unique per site
  name           String
  photoUrl       String?
  phone          String?
  trade          Trade
  joiningDate    DateTime  @db.Date
  leavingDate    DateTime? @db.Date
  wageType       WageType  @default(PER_DAY)
  contractorName String?
  idDocRef       String? // reference number only, never a document upload
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  wageRates  WageRate[]
  expenses   Expense[]
  attendance Attendance[]
  advances   Advance[]
  wageSheets WageSheet[]
  workLogs   StageWorkLog[]

  @@unique([siteId, code])
}

/// Rate history. The rate in force on a date is the latest row with effectiveFrom <= date.
model WageRate {
  id            String   @id @default(cuid())
  workerId      String
  worker        Worker   @relation(fields: [workerId], references: [id])
  rate          Decimal  @db.Decimal(10, 2)
  otRate        Decimal? @db.Decimal(10, 2) // per hour; null = 1.5x hourly equivalent
  effectiveFrom DateTime @db.Date
  setById       String
  setBy         User     @relation(fields: [setById], references: [id])
  createdAt     DateTime @default(now())

  @@index([workerId, effectiveFrom])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  HOLIDAY
}

model Attendance {
  id         String           @id @default(cuid())
  siteId     String
  site       Site             @relation(fields: [siteId], references: [id])
  workerId   String
  worker     Worker           @relation(fields: [workerId], references: [id])
  date       DateTime         @db.Date
  status     AttendanceStatus
  inTime     String? // "HH:MM" IST
  outTime    String?
  otHours    Decimal          @default(0) @db.Decimal(4, 1)
  remark     String?
  markedById String
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  voidedAt   DateTime?
  voidReason String?

  @@unique([workerId, date])
  @@index([siteId, date])
}

model Holiday {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  @@unique([siteId, date])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Advance {
  id            String         @id @default(cuid())
  siteId        String
  site          Site           @relation(fields: [siteId], references: [id])
  workerId      String
  worker        Worker         @relation(fields: [workerId], references: [id])
  amount        Decimal        @db.Decimal(12, 2)
  reason        String
  status        ApprovalStatus @default(PENDING)
  requestedById String
  requestedBy   User           @relation("AdvanceRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime       @default(now())
  decidedById   String?
  decidedBy     User?          @relation("AdvanceDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  paidAt        DateTime?
  wageSheetId   String? // set when deducted
  wageSheet     WageSheet?     @relation(fields: [wageSheetId], references: [id])
  voidedAt      DateTime?
  voidReason    String?

  @@index([siteId, status])
}

enum WagePeriod {
  WEEKLY
  MONTHLY
}

enum WageSheetStatus {
  DRAFT
  FINAL
  PAID
}

model WageSheet {
  id               String          @id @default(cuid())
  siteId           String
  site             Site            @relation(fields: [siteId], references: [id])
  workerId         String
  worker           Worker          @relation(fields: [workerId], references: [id])
  period           WagePeriod
  periodStart      DateTime        @db.Date
  periodEnd        DateTime        @db.Date
  daysPresent      Decimal         @db.Decimal(5, 1)
  hours            Decimal         @db.Decimal(7, 1)
  otHours          Decimal         @db.Decimal(7, 1)
  grossWage        Decimal         @db.Decimal(12, 2)
  advancesDeducted Decimal         @db.Decimal(12, 2)
  netPayable       Decimal         @db.Decimal(12, 2)
  status           WageSheetStatus @default(DRAFT)
  generatedById    String
  generatedBy      User            @relation(fields: [generatedById], references: [id])
  generatedAt      DateTime        @default(now())
  paidAt           DateTime?
  voidedAt         DateTime?
  voidReason       String?

  advances Advance[]

  @@unique([workerId, period, periodStart])
  @@index([siteId, periodStart])
}

// ---------------------------------------------------------------------------
// Petty cash
// ---------------------------------------------------------------------------

enum Urgency {
  NORMAL
  URGENT
  WORK_STOPPED
}

enum PettyRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SENT
}

enum PaymentMode {
  UPI
  BANK
  CASH
}

model PettyCashRequest {
  id            String             @id @default(cuid())
  siteId        String
  site          Site               @relation(fields: [siteId], references: [id])
  amount        Decimal            @db.Decimal(12, 2)
  reason        String
  urgency       Urgency            @default(NORMAL)
  status        PettyRequestStatus @default(PENDING)
  requestedById String
  requestedBy   User               @relation("PettyReqRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime           @default(now())
  decidedById   String?
  decidedBy     User?              @relation("PettyReqDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  sentAt        DateTime?
  sentMode      PaymentMode?
  sentRef       String?
  voidedAt      DateTime?
  voidReason    String?

  txns PettyCashTxn[]

  @@index([siteId, status])
}

enum PettyTxnType {
  TOPUP
  EXPENSE
  RETURN // unspent cash handed back to head office
  ADJUSTMENT
}

enum PettyCategory {
  LABOUR_FOOD
  LOCAL_TRANSPORT
  SMALL_PURCHASE
  HARDWARE
  MEDICAL
  MISC
}

model PettyCashTxn {
  id                  String             @id @default(cuid())
  siteId              String
  site                Site               @relation(fields: [siteId], references: [id])
  date                DateTime           @db.Date
  type                PettyTxnType
  amount              Decimal            @db.Decimal(12, 2) // positive; sign determined by type
  category            PettyCategory?
  description         String
  paidTo              String?
  billPhotoUrl        String?
  requestId           String?
  request             PettyCashRequest?  @relation(fields: [requestId], references: [id])
  consumableRequestId String?            @unique
  consumableRequest   ConsumableRequest? @relation(fields: [consumableRequestId], references: [id])
  enteredById         String
  enteredBy           User               @relation(fields: [enteredById], references: [id])
  createdAt           DateTime           @default(now())
  expenseId           String?            @unique
  expense             Expense?           @relation(fields: [expenseId], references: [id])
  voidedAt            DateTime?
  voidReason          String?

  @@index([siteId, date])
}

model PettyCashReconciliation {
  id           String   @id @default(cuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id])
  month        DateTime @db.Date // first day of month
  physicalCash Decimal  @db.Decimal(12, 2)
  appBalance   Decimal  @db.Decimal(12, 2)
  note         String?
  enteredById  String
  enteredBy    User     @relation(fields: [enteredById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([siteId, month])
}

/// What kind of spend this is. Only a purchase can be expected to have a bill,
/// so this — not the category — decides whether a receipt photo is required.
enum EntryType {
  PURCHASE // bill expected
  PAYMENT // paid to a person, no bill
  OTHER
}

/// Where the money came from. Company-paid spending belongs to the job cost but
/// must NOT reduce anyone's cash in hand, so it posts no ledger row at all.
enum PaymentSource {
  WORKER_CASH // paid out of the cash this person is holding
  COMPANY_DIRECT // office/bank paid the shop; no site cash moved
}

enum ExpenseStatus {
  PENDING
  APPROVED
  QUERIED
  REJECTED
}

enum PartyKind {
  LABOUR
  VENDOR
  OTHER
}

/// Spend categories. `requiresPerson` shows the labour picker so per-person
/// totals group properly; `requiresMachine` asks which machine and what was
/// wrong, so a repair cost can be traced to the machine causing it.
model ExpenseCategory {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  requiresPerson  Boolean  @default(false)
  requiresMachine Boolean  @default(false)
  sortOrder       Int      @default(500)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  expenses Expense[]

  @@index([active, sortOrder])
}

/// Every name money was paid to gets a ledger, whether a labourer or a shop.
/// Names are matched on a normalised key so "Kamla Hardware" and "kamla
/// hardware" land on one payee instead of two.
model Party {
  id             String    @id @default(cuid())
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id])
  kind           PartyKind @default(VENDOR)
  name           String
  normalizedName String
  phone          String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  expenses Expense[]
  bills    Bill[]
  orders   ConsumableRequest[] @relation("OrderVendor")

  @@unique([siteId, normalizedName])
  @@index([siteId, kind])
}

/// One bill from one payee on one day — a photo and several lines. Each line is
/// an Expense, so approval and the cash ledger keep working per line, while the
/// site enters the whole bill at once.
model Bill {
  id           String        @id @default(cuid())
  siteId       String
  site         Site          @relation(fields: [siteId], references: [id])
  date         DateTime      @db.Date
  partyId      String?
  party        Party?        @relation(fields: [partyId], references: [id])
  payeeText    String?
  billNo       String?
  billPhotoUrl String?
  paidFrom     PaymentSource @default(WORKER_CASH)
  note         String?
  spentById    String
  spentBy      User          @relation("BillSpentBy", fields: [spentById], references: [id])
  enteredById  String
  enteredBy    User          @relation("BillEnteredBy", fields: [enteredById], references: [id])
  createdAt    DateTime      @default(now())
  voidedAt     DateTime?
  voidReason   String?

  lines Expense[]

  @@index([siteId, date])
  @@index([partyId])
}

/// One recorded spend. Raised on site, approved by the superadmin; approval is
/// what posts money out of the spender's cash ledger.
model Expense {
  id         String          @id @default(cuid())
  siteId     String
  site       Site            @relation(fields: [siteId], references: [id])
  date       DateTime        @db.Date
  amount     Decimal         @db.Decimal(12, 2)
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  entryType  EntryType       @default(PURCHASE)
  paidFrom   PaymentSource   @default(WORKER_CASH)

  /// What was actually bought. An amount with no description is unauditable months later.
  description String
  note        String?

  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id])
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id])
  payeeText String?
  workerId  String?
  worker    Worker?  @relation(fields: [workerId], references: [id])
  machineId String?
  machine   Machine? @relation(fields: [machineId], references: [id])

  /// Filled when the category asks for a machine, so repeat faults are visible.
  problem  String?
  solution String?

  billPhotoUrl String?
  billId       String?
  bill         Bill?   @relation(fields: [billId], references: [id])

  /// Whose cash this came out of. Approval debits this person's ledger.
  spentById String
  spentBy   User   @relation("ExpenseSpentBy", fields: [spentById], references: [id])

  enteredById String
  enteredBy   User   @relation("ExpenseEnteredBy", fields: [enteredById], references: [id])

  status       ExpenseStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?         @relation("ExpenseDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  ledgerEntries CashLedger[]
  pettyCashTxn  PettyCashTxn?

  @@index([siteId, status])
  @@index([siteId, date])
  @@index([spentById, status])
  @@index([categoryId, date])
  @@index([machineId])
}

enum LedgerKind {
  ADVANCE // cash issued to a person
  TOPUP // more cash issued
  EXPENSE // approved spending out of their cash
  RETURN // cash handed back to head office
  ADJUSTMENT // superadmin correction, signed
}

/// Append-only cash-in-hand ledger. A person's balance is never a stored
/// column: it is always the sum of these rows, so a mistake is corrected by
/// posting a reversing row rather than editing history.
///
/// Sign convention, from the holder's point of view:
///   ADVANCE/TOPUP  +   EXPENSE/RETURN  -   ADJUSTMENT  either way
model CashLedger {
  id       String     @id @default(cuid())
  siteId   String
  site     Site       @relation(fields: [siteId], references: [id])
  holderId String
  holder   User       @relation("LedgerHolder", fields: [holderId], references: [id])
  kind     LedgerKind
  amount   Decimal    @db.Decimal(12, 2) // signed

  sourceType String // "expense" | "petty_request" | "manual" | "reversal"
  sourceId   String?

  /// "<sourceType>:<sourceId>:<kind>" — the unique index here is what stops a
  /// retried approval from debiting anyone twice.
  postingKey String @unique

  expenseId String?
  expense   Expense? @relation(fields: [expenseId], references: [id])

  /// Set on a correcting row, pointing at the row it cancels. The correcting row
  /// carries the same kind with the amount negated, so the advanced/spent
  /// breakdown self-corrects and not just the total.
  reversesId String?     @unique
  reverses   CashLedger? @relation("LedgerReversal", fields: [reversesId], references: [id])
  reversedBy CashLedger? @relation("LedgerReversal")

  memo        String?
  createdById String
  createdBy   User     @relation("LedgerPostedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([siteId, holderId, createdAt])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Machines
// ---------------------------------------------------------------------------

enum MachineType {
  WELDING_MACHINE
  GRINDER
  GAS_CUTTING_SET
  DRILLING_MACHINE
  CHAIN_PULLEY_BLOCK
  DG_SET
  COMPRESSOR
  OTHER
}

enum MachineStatus {
  AT_FACTORY
  RUNNING
  IDLE
  UNDER_REPAIR
  SENT_OUT_FOR_REPAIR
  RETURNED_TO_FACTORY
}

enum Condition {
  GOOD
  AVERAGE
  NEEDS_REPAIR
}

enum Ownership {
  OWNED
  RENTED
}

model Machine {
  id            String        @id @default(cuid())
  machineNumber String        @unique // M-014
  type          MachineType
  make          String?
  model         String?
  serialNo      String?
  ownership     Ownership     @default(OWNED)
  rentVendor    String?
  rentPerMonth  Decimal?      @db.Decimal(12, 2)
  rentFrom      DateTime?     @db.Date
  rentTo        DateTime?     @db.Date
  siteId        String? // current site, null while at factory
  site          Site?         @relation(fields: [siteId], references: [id])
  status        MachineStatus @default(AT_FACTORY)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  dispatches MachineDispatch[]
  tickets    MachineTicket[]
  expenses   Expense[]
}

enum DispatchDirection {
  TO_SITE
  TO_FACTORY
}

model MachineDispatch {
  id                  String            @id @default(cuid())
  machineId           String
  machine             Machine           @relation(fields: [machineId], references: [id])
  siteId              String
  site                Site              @relation(fields: [siteId], references: [id])
  direction           DispatchDirection
  dispatchDate        DateTime          @db.Date
  dispatchPhotoUrl    String?
  conditionOnDispatch Condition
  dispatchedById      String
  dispatchedBy        User              @relation("MachineDispatchedBy", fields: [dispatchedById], references: [id])
  receivedAt          DateTime?
  receivedPhotoUrl    String?
  conditionOnReceipt  Condition?
  receivedById        String?
  receivedBy          User?             @relation("MachineReceivedBy", fields: [receivedById], references: [id])
  remark              String?
  createdAt           DateTime          @default(now())
  voidedAt            DateTime?
  voidReason          String?

  @@index([siteId, dispatchDate])
}

enum RepairType {
  IN_HOUSE
  SENT_OUT
}

enum TicketStatus {
  OPEN
  IN_REPAIR
  RESOLVED
}

model MachineTicket {
  id               String       @id @default(cuid())
  machineId        String
  machine          Machine      @relation(fields: [machineId], references: [id])
  siteId           String
  site             Site         @relation(fields: [siteId], references: [id])
  problem          String
  raisedOn         DateTime     @db.Date
  raisedById       String
  raisedBy         User         @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  status           TicketStatus @default(OPEN)
  repairType       RepairType?
  repairedBy       String? // person or vendor name
  repairCost       Decimal?     @db.Decimal(12, 2)
  downtimeDays     Decimal?     @db.Decimal(5, 1)
  resolvedAt       DateTime?
  verifiedById     String? // mandatory sign-off when resolving
  verifiedBy       User?        @relation("TicketVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  verificationNote String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  voidedAt         DateTime?
  voidReason       String?

  parts MachineTicketPart[]

  @@index([siteId, status])
}

model MachineTicketPart {
  id       String        @id @default(cuid())
  ticketId String
  ticket   MachineTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  item     String
  qty      Decimal       @default(1) @db.Decimal(10, 2)
  price    Decimal       @db.Decimal(12, 2)
}

// ---------------------------------------------------------------------------
// Consumables
// ---------------------------------------------------------------------------

enum ConsumableCategory {
  WELDING_ELECTRODE
  MIG_WIRE
  GAS
  GRINDING
  CUTTING
  HAND_TOOL
  PPE_SAFETY
  PAINT
  HARDWARE
  OTHER
}

/// Global item master (shared across sites). Stock and consumption are per site.
model ConsumableItem {
  id                  String             @id @default(cuid())
  name                String             @unique
  category            ConsumableCategory
  unit                String // kg, nos, cylinder, litre, box
  reorderLevel        Decimal            @default(0) @db.Decimal(12, 3)
  isWeldingConsumable Boolean            @default(false) // counted in kg-per-MT norm check
  kgPerUnit           Decimal?           @db.Decimal(10, 4) // conversion for norm check when unit != kg
  active              Boolean            @default(true)
  /// False when a site user added it while ordering: usable at once, but flagged for the superadmin.
  approved            Boolean            @default(true)
  proposedById        String?
  proposedBy          User?              @relation("ItemProposedBy", fields: [proposedById], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  dispatches   ConsumableDispatch[]
  jobMaterials JobMaterial[]
  stock        ConsumableStock[]
  consumptions ConsumableConsumption[]
  requests     ConsumableRequest[]
}

model ConsumableDispatch {
  id             String             @id @default(cuid())
  siteId         String
  site           Site               @relation(fields: [siteId], references: [id])
  itemId         String
  item           ConsumableItem     @relation(fields: [itemId], references: [id])
  requestId      String?
  request        ConsumableRequest? @relation(fields: [requestId], references: [id])
  qty            Decimal            @db.Decimal(12, 3)
  dispatchDate   DateTime           @db.Date
  photoUrl       String?
  vehicleRef     String?
  dispatchedById String
  dispatchedBy   User               @relation("ConsDispatchedBy", fields: [dispatchedById], references: [id])
  receivedQty    Decimal?           @db.Decimal(12, 3)
  receivedAt     DateTime?
  receivedById   String?
  receivedBy     User?              @relation("ConsReceivedBy", fields: [receivedById], references: [id])
  shortReceipt   Boolean            @default(false)
  receiptRemark  String?
  createdAt      DateTime           @default(now())
  voidedAt       DateTime?
  voidReason     String?

  @@index([siteId, dispatchDate])
}

model ConsumableStock {
  id        String         @id @default(cuid())
  siteId    String
  site      Site           @relation(fields: [siteId], references: [id])
  itemId    String
  item      ConsumableItem @relation(fields: [itemId], references: [id])
  qtyOnHand Decimal        @default(0) @db.Decimal(12, 3)
  updatedAt DateTime       @updatedAt

  @@unique([siteId, itemId])
}

model ConsumableConsumption {
  id          String         @id @default(cuid())
  siteId      String
  site        Site           @relation(fields: [siteId], references: [id])
  itemId      String
  item        ConsumableItem @relation(fields: [itemId], references: [id])
  jobId       String
  job         Job            @relation(fields: [jobId], references: [id])
  stageId     String?
  stage       Stage?         @relation(fields: [stageId], references: [id])
  date        DateTime       @db.Date
  qty         Decimal        @db.Decimal(12, 3)
  remark      String?
  enteredById String
  enteredBy   User           @relation(fields: [enteredById], references: [id])
  createdAt   DateTime       @default(now())
  voidedAt    DateTime?
  voidReason  String?

  @@index([siteId, date])
  @@index([jobId])
}

enum ConsRequestStatus {
  PENDING // raised on site, waiting for Arnav
  APPROVED // approved, waiting for the purchase desk to order
  ORDERED // purchase desk has placed the order with a vendor
  REJECTED
  FULFILLED // material inwarded and accepted at site
}

enum Fulfilment {
  FROM_FACTORY // send from existing factory stock
  PURCHASE_ORDER // purchase desk in Pune buys from a vendor
  LOCAL_PURCHASE // site buys locally against petty cash
}

/// A material indent: several items asked for together, one reason, one date.
/// Each line is a ConsumableRequest so approval, ordering and inward still work per item.
model MaterialIndent {
  id            String    @id @default(cuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id])
  indentNo      String    @unique // IND-001
  reason        String
  neededBy      DateTime  @db.Date
  note          String?
  requestedById String
  requestedBy   User      @relation("IndentRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime  @default(now())
  voidedAt      DateTime?
  voidReason    String?

  lines ConsumableRequest[]

  @@index([siteId, requestedAt])
}

model ConsumableRequest {
  id              String            @id @default(cuid())
  siteId          String
  site            Site              @relation(fields: [siteId], references: [id])
  itemId          String
  item            ConsumableItem    @relation(fields: [itemId], references: [id])
  indentId        String?
  indent          MaterialIndent?   @relation(fields: [indentId], references: [id])
  qty             Decimal           @db.Decimal(12, 3)
  reason          String
  neededBy        DateTime          @db.Date
  status          ConsRequestStatus @default(PENDING)
  fulfilment      Fulfilment?
  requestedById   String
  requestedBy     User              @relation("ConsReqRequestedBy", fields: [requestedById], references: [id])
  requestedAt     DateTime          @default(now())
  decidedById     String?
  decidedBy       User?             @relation("ConsReqDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  decisionNote    String?
  purchaseBillUrl String?
  purchasePrice   Decimal?          @db.Decimal(12, 2)
  purchasedAt     DateTime?
  // Purchase desk (Pune) order details
  vendorName      String?
  vendorPartyId   String?
  vendorParty     Party?            @relation("OrderVendor", fields: [vendorPartyId], references: [id])
  poNumber        String?
  unitPrice       Decimal?          @db.Decimal(12, 2)
  expectedDate    DateTime?         @db.Date
  orderedAt       DateTime?
  orderedById     String?
  orderedBy       User?             @relation("ConsReqOrderedBy", fields: [orderedById], references: [id])
  orderNote       String?
  voidedAt        DateTime?
  voidReason      String?

  pettyCashTxn PettyCashTxn?
  dispatches   ConsumableDispatch[]

  @@index([siteId, status])
}

// ---------------------------------------------------------------------------
// Issues
// ---------------------------------------------------------------------------

enum IssueCategory {
  MATERIAL_SHORTAGE
  MACHINE_BREAKDOWN
  MANPOWER_SHORT
  DRAWING_CLARIFICATION
  CLIENT_HOLD
  POWER_WATER
  SAFETY
  PAYMENT
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  WORK_STOPPED
}

enum IssueStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
}

model Issue {
  id             String        @id @default(cuid())
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id])
  jobId          String?
  job            Job?          @relation(fields: [jobId], references: [id])
  category       IssueCategory
  severity       Severity
  description    String
  photoUrl       String?
  neededFromHO   String?
  status         IssueStatus   @default(OPEN)
  raisedById     String
  raisedBy       User          @relation("IssueRaisedBy", fields: [raisedById], references: [id])
  raisedAt       DateTime      @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolutionNote String?
  closedById     String?
  closedBy       User?         @relation("IssueClosedBy", fields: [closedById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  voidedAt       DateTime?
  voidReason     String?

  @@index([siteId, status, severity])
}

// ---------------------------------------------------------------------------
// Daily plan & DPR
// ---------------------------------------------------------------------------

model DailyPlan {
  id            String    @id @default(cuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id])
  date          DateTime  @db.Date
  remark        String?
  submittedById String
  submittedBy   User      @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  voidedAt      DateTime?
  voidReason    String?

  items DailyPlanItem[]

  @@unique([siteId, date])
}

model DailyPlanItem {
  id              String    @id @default(cuid())
  planId          String
  plan            DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job       @relation(fields: [jobId], references: [id])
  stageId         String
  stage           Stage     @relation(fields: [stageId], references: [id])
  targetQty       Decimal   @db.Decimal(12, 3)
  manpowerPlanned Int
  note            String?
}

enum DPRStatus {
  DRAFT
  SUBMITTED
  MISSING
}

model DPR {
  id            String    @id @default(cuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id])
  date          DateTime  @db.Date
  status        DPRStatus @default(DRAFT)
  snapshot      Json? // compiled report frozen at submission
  remark        String?
  submittedById String?
  submittedBy   User?     @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  voidedAt      DateTime?
  voidReason    String?

  @@unique([siteId, date])
}

// ---------------------------------------------------------------------------
// Photos
// ---------------------------------------------------------------------------

enum PhotoKind {
  DAILY_SLOT
  MUSTER
}

model SitePhoto {
  id         String    @id @default(cuid())
  siteId     String
  site       Site      @relation(fields: [siteId], references: [id])
  kind       PhotoKind
  date       DateTime  @db.Date
  slot       Int? // 1..5 for DAILY_SLOT
  url        String
  latitude   Float
  longitude  Float
  accuracyM  Float
  serverTime DateTime  @default(now())
  caption    String?
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id])
  stageId    String?
  stage      Stage?    @relation(fields: [stageId], references: [id])
  takenById  String
  takenBy    User      @relation(fields: [takenById], references: [id])
  voidedAt   DateTime?
  voidReason String?

  @@index([siteId, date])
}

// ---------------------------------------------------------------------------
// Audit & backdate unlocks
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // CREATE / UPDATE / APPROVE / REJECT / VOID / LOGIN / UNLOCK ...
  entity    String // model name
  entityId  String?
  oldValues Json?
  newValues Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([siteId, createdAt])
}

enum UnlockModule {
  ATTENDANCE
  CONSUMPTION
  PHOTOS
  EXPENSES
  STAGE_PROGRESS
}

/// Superadmin-granted permission to enter data for a past date. Logged in AuditLog too.
model BackdateUnlock {
  id           String       @id @default(cuid())
  siteId       String
  site         Site         @relation(fields: [siteId], references: [id])
  module       UnlockModule
  date         DateTime     @db.Date
  reason       String
  unlockedById String
  unlockedBy   User         @relation(fields: [unlockedById], references: [id])
  expiresAt    DateTime
  createdAt    DateTime     @default(now())

  @@index([siteId, module, date])
}
